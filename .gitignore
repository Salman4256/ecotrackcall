# ==============================================================================
# EcoTrack Root .gitignore
# ==============================================================================

# Node / Build Outputs
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.cert

# Vercel Deployment artifacts
.vercel/

# Python / Caches
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo

# Antigravity Logs & Scratch
.gemini/
.system_generated/
scratch/
